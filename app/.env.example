# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit it.

DB_USER=mns_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MNS

# Generate your own with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE_MINUTES=60

# Twilio, for the SMS notifications. Optional: leave these blank and the
# notifications page runs in dry run - it logs each message and reports
# "dry run" instead of sending. Fill them in and it starts sending for real.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Gmail, for reminder emails. Optional, same dry run as Twilio when blank.
# Needs 2-Step Verification on the account and an App Password from
# https://myaccount.google.com/apppasswords (the spaces do not matter).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# How often the reminder loop runs. Short, so procedure-preparation
# reminders ("stop eating now") arrive close to their time. 0 turns the loop
# off (the "check now" button still works).
REMINDER_EVERY_MINUTES=1

# Daily reminders (late / upcoming items) go out from this hour, once a day,
# so nobody gets a text at midnight. Preparation reminders ignore it.
REMINDER_SEND_HOUR=9
